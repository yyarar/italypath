# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
# Server-only. Production ve Preview'da zorunlu: SAT soru okuma (lib/sat/questions.server.ts),
# uzman on gorusme formu insert'i (lib/mentor/expertLeads.server.ts) ve yetkili admin/import scriptleri.
# Asla client bundle'a veya NEXT_PUBLIC_* alanina koyma. Local'de yalnizca bu yuzeyler test edilecekse gerekir.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key-server-only

# Clerk
# Local development may use Clerk test keys. Vercel Production must use Clerk production keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace-with-clerk-production-publishable-key
CLERK_SECRET_KEY=sk_live_replace-with-clerk-production-secret-key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/giris
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/giris?mode=kayit
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/hub
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/hosgeldin
# Yerel gelistirme: Clerk oturumunun kabul edildigi yerel adres(ler), virgulle ayrilmis.
# Verilmezse http://localhost:3000. Vercel Production ve Preview'da okunmaz (lib/auth/trustedOrigins.ts).
# CLERK_DEV_ORIGINS=http://localhost:3000

# Supabase yedegi (yalniz yerel; npm run backup:supabase, SUPABASE_SECURITY_RUNBOOK.md bolum 7).
# Vercel'e EKLENMEZ. Baglanti dizesi: Dashboard -> Connect -> Session pooler (5432).
# SUPABASE_DB_URL=
# BACKUP_PASSPHRASE=
# BACKUP_DIR=

# AI mentor (/api/chat; anahtar yoksa 503 doner. AI masasi arayuzde duraklatilmis.)
GEMINI_API_KEY=replace-with-gemini-api-key
